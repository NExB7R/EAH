.floating-capsule {
  position: fixed;
  top: 16px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  width: calc(100% - 32px);
  max-width: 780px;
  transition: top 400ms cubic-bezier(0.34, 1.2, 0.64, 1);
}

.floating-capsule.is-scrolled {
  top: 8px;
}

.floating-capsule__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(10, 8, 18, 0.65);
  border: 1px solid rgba(139, 92, 246, 0.22);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.02),
    0 10px 40px rgba(0, 0, 0, 0.5),
    0 0 60px rgba(107, 33, 255, 0.12);
  transition: box-shadow 400ms ease, padding 400ms ease;
}

.floating-capsule.is-scrolled .floating-capsule__inner {
  padding: 8px 12px;
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.02),
    0 12px 50px rgba(0, 0, 0, 0.65),
    0 0 80px rgba(107, 33, 255, 0.2);
}

.floating-capsule__side {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
}

.floating-capsule__side--end {
  justify-content: flex-end;
}

.floating-capsule__center {
  flex-shrink: 0;
}

@media (max-width: 640px) {
  .floating-capsule {
    top: 8px;
  }
  .floating-capsule__inner {
    padding: 8px 10px;
    gap: 8px;
  }
  .floating-capsule__side {
    gap: 4px;
  }
}
