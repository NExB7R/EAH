{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "context-map": "node scripts/gen-context-map.mjs",
    "prepare": "lefthook install || true",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "dup": "jscpd --threshold 5 --min-tokens 70 app components lib",
    "secrets": "gitleaks protect --staged --redact --no-banner",
    "audit:security": "npm audit --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa:seed:accounts": "node scripts/seed-qa-accounts.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@serwist/next": "^9.5.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "html-to-image": "^1.11.13",
    "next": "^16.4.6",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "server-only": "^0.0.1",
    "serwist": "^9.5.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.210",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jscpd": "^5.4.3",
    "jsdom": "^25.0.1",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  }
}
