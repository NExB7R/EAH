{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "dup": "jscpd --threshold 5 --min-tokens 70 app components lib",
    "secrets": "gitleaks protect --staged --redact --no-banner",
    "audit:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jscpd": "^5.3.3",
    "knip": "^6.38.0",
    "lefthook": "^2.1.15",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
