{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,manifest,sitemap,robots,opengraph-image,icon,apple-icon}.{ts,tsx}",
    "app/**/route.{ts,tsx}"
  ],
  "project": ["**/*.{ts,tsx}"],
  "ignore": ["lib/trust.ts"],
  "ignoreBinaries": ["gitleaks"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "dependencies": "error",
    "files": "error"
  }
}
