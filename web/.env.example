# ═══════════════════════════════════════════════════════════
# EAH — Environment Variables (Example)
# ═══════════════════════════════════════════════════════════
# انسخ الملف ده إلى .env.local واملا القيم الحقيقية.
# ممنوع commit .env.local — ده مثال فقط.
# ═══════════════════════════════════════════════════════════

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ───
NEXT_PUBLIC_SITE_URL=

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# ─── Cron ───
CRON_SECRET=
SUPABASE_CRON_SECRET=

# ─── Analytics ───
EAH_VISITOR_SALT=
